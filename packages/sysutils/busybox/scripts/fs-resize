#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2009-2014 Stephan Raue (stephan@openelec.tv)

StartProgressLog() {
  if [ "$1" = "spinner" ]; then
    echo "*** $3" >>$LOG
  fi
  StartProgress "$@"
}

if [ -e /storage/.please_resize_me ] ; then
  . /usr/lib/libreelec/functions

  hidecursor

  mount -o remount,rw /flash
  LOG=/flash/fs-resize.log
  date -Iseconds >>$LOG

  # this sh** was never intended to be used
  # on already installed and runing system
  if [ -d /storage/.kodi -o -d /storage/.config -o -d /storage/.cache ] ; then
    rm -f /storage/.please_resize_me
    sync
    echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
    mount -o remount,ro /flash
    StartProgress countdown "Rebooting in 15s... " 15 "NOW"
    reboot -f
  fi

  # get the disk. /storage on 2nd partition
  echo $(grep "/storage " /proc/mounts) >>$LOG
  PART=$(grep "/storage " /proc/mounts | cut -d" " -f1 | grep '2$')

  # get disk: /dev/sdx2 -> /dev/sdx, /dev/mmcblkxp2 -> /dev/mmcblkx
  case $PART in
    "/dev/mmcblk"*|"/dev/nvme"*)
      DISK=$(echo $PART | sed s/p2$//g)
      EXFAT_PART=${DISK}p3
      ;;
    *)
      DISK=$(echo $PART | sed s/2$//g)
      EXFAT_PART=${DISK}3
      ;;
  esac

  rm -f /storage/.please_resize_me
  sync

  echo "DISK: $DISK  PART: $PART" >>$LOG

  # default values for exfat partition
  EXFAT=no
  EXT4_SIZE_IN_MB=@EXT4_DEFAULT_SIZE@
  EXFAT_MNT=/storage/exfat
  if [ -f /flash/partition-setup.txt ]; then
    while IFS= read -r line ; do
      # skip empty lines
      [ -z "${line}" ] && continue
      # skip comments
      [ "${line:0:1}" = "#" ] && continue
      key=$(echo $line | cut -d'=' -f 1 2>/dev/null)
      value=$(echo $line | cut -d'=' -f 2 2>/dev/null)
      # skip if any of key or value is blank
      [ -z "$key" -o -z "$value" ] && continue
      case $key in
        EXFAT)
          if [ "$value" = "yes" ]; then
            EXFAT=yes
          fi
          ;;
        EXT4_SIZE_IN_MB)
          # accept only digits
          if [[ $value =~ '^[0-9]+$' ]]; then
            # check min/max and multiple of 128
            if [ $value -ge 256 -a $value -le 4096 -a $(( value % 128)) -eq 0 ]; then
              EXT4_SIZE_IN_MB=$value
            fi
          fi
          ;;
      esac
    done < /flash/partition-setup.txt
  fi

  # just in case
  if [ ! -z "$DISK" -a ! -z "$PART" ] ; then
    umount $PART

    echo "PARTITION RESIZING IN PROGRESS"
    echo ""
    echo "Please do not reboot or turn off your @DISTRONAME@ device!"
    echo ""

    # identify the partition scheme, and if gpt fix minor issues such as gpt header not at end of disk
    SCHEME=$(blkid -s PTTYPE -o value $DISK)
    if [ "$SCHEME" = "gpt" ]; then
      StartProgressLog spinner "Checking layout...         " "sgdisk -e $DISK >>$LOG 2>&1"
      EXFAT_PART_TYPE="'EXFAT'"
    else
      EXFAT_PART_TYPE="primary"
    fi

    if [ "$EXFAT" = "yes" ]; then
      EXT4_START=$(( $(parted -s -f -m $DISK print 2>/dev/null | grep -m1 ^2: | cut -d: -f2 | sed -e s/MB//) ))
      EXT4_END=$(( EXT4_START + EXT4_SIZE_IN_MB ))
      StartProgressLog spinner "Get disk information...    " "parted -s -f -m $DISK print all >>$LOG 2>&1"
      StartProgressLog spinner "Resize ext4 partition...   " "parted -s -m $DISK resizepart 2 ${EXT4_END}MiB >>$LOG 2>&1"
      StartProgressLog spinner "Check ext4 partition...    " "e2fsck -f -p $PART >>$LOG 2>&1"
      StartProgressLog spinner "Mount ext4 partition...    " "mount $PART /storage >>$LOG 2>&1"
      StartProgressLog spinner "Resize ext4 file system... " "resize2fs $PART >>$LOG 2>&1"
      StartProgressLog spinner "Update disk information... " "parted -s -f -m $DISK print all >>$LOG 2>&1"
      EXFAT_START=$(( $(parted -s -f -m $DISK print 2>/dev/null | grep -m1 ^2: | cut -d: -f3 | sed -e s/MB//) + 1 ))
      StartProgressLog spinner "Create exFAT partition...  " "parted -s -f -m $DISK mkpart $EXFAT_PART_TYPE ntfs ${EXFAT_START}MB 100% >>$LOG 2>&1"
      StartProgressLog spinner "Probe partitions...        " "partprobe >>$LOG 2>&1"
      StartProgressLog spinner "Format exFAT partition...  " "mkfs.exfat -L EXFAT $EXFAT_PART >>$LOG 2>&1"
      StartProgressLog spinner "Create exFAT mount point..." "mkdir $EXFAT_MNT >>$LOG 2>&1"
      StartProgressLog spinner "Mount exFAT...             " "mount $EXFAT_PART $EXFAT_MNT >>$LOG 2>&1"
      StartProgressLog spinner "Set up exFAT partition...  " "sh /usr/bin/lakka-populate-exfat.sh $EXFAT_MNT >>$LOG 2>&1"
      StartProgressLog spinner "Unmount exFAT...           " "umount $EXFAT_MNT >>$LOG 2>&1"
      StartProgressLog spinner "Remove exFAT mount point..." "rmdir $EXFAT_MNT >>$LOG 2>&1"
      if [ -f /flash/firstboot.sh ]; then
        StartProgressLog spinner "Run firstboot.sh...        " "sh /flash/firstboot.sh >>$LOG 2>&1"
      fi
      StartProgressLog spinner "Unmount ext4...            " "umount /storage >>$LOG 2>&1"
      echo "SCHEME='$SCHEME' EXFAT_PART_TYPE='$EXFAT_PART_TYPE' EXT4_START='$EXT4_START' EXT4_SIZE_IN_MB='$EXT4_SIZE_IN_MB' EXT4_END='$EXT4_END' EXFAT_START='$EXFAT_START'" >>$LOG
    else
      StartProgressLog spinner "Resizing partition...      " "parted -s -m $DISK resizepart 2 100% >>$LOG 2>&1"
      StartProgressLog spinner "Checking file system...    " "e2fsck -f -p $PART >>$LOG 2>&1"
      StartProgressLog spinner "Mounting file system...    " "mount $PART /storage >>$LOG 2>&1"
      StartProgressLog spinner "Resizing file system...    " "resize2fs $PART >>$LOG 2>&1"
      if [ -f /flash/firstboot.sh ]; then
        StartProgressLog spinner "Running firstboot.sh...    " "sh /flash/firstboot.sh >>$LOG 2>&1"
      fi
      StartProgressLog spinner "Unmounting file system...  " "umount /storage >>$LOG 2>&1"
    fi
    StartProgress countdown "Rebooting in 15s...         " 15 "NOW"
  else
    echo "Partition was not detected - resizing aborted."
    StartProgress countdown "Rebooting in 15s... " 15 "NOW"
  fi
  mount -o remount,ro /flash
fi
reboot -f &>/dev/null
