################################################################################
# Device defaults
################################################################################

  # NOOBS supported hex versions (legacy) is not relevant for RPi4
    unset NOOBS_HEX

  # NOOBS supported model versions
    NOOBS_SUPPORTED_MODELS='"Pi 5"'

  # additional Firmware to use (dvb-firmware, misc-firmware, wlan-firmware)
    FIRMWARE="${FIRMWARE} rpi-eeprom flashrom"

  # set the addon project
    ADDON_PROJECT="ARMv8"

  # debug tty path
    DEBUG_TTY="/dev/ttyAMA10"

  # serial console
    EXTRA_CMDLINE="console=ttyAMA10,115200 console=tty0 video=Composite-1:720x480,tv_mode=NTSC-J drm_rp1_vec.cmode=27000:720/16/64/58,480/6/6/34"

  # Remove drivers
  for _driver in RTL8192CU RTL8192DU RTL8192EU RTL8188EU RTL8812AU ; do
    ADDITIONAL_DRIVERS="${ADDITIONAL_DRIVERS//${_driver}/}"
  done
